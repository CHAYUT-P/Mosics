#include <winver.h>
// MOSICS_VERSION ("1.1.0") and MOSICS_VERSION_NUM (1,1,0,0) come from ../VERSION via build.sh.
1 ICON "mosics.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION MOSICS_VERSION_NUM
PRODUCTVERSION MOSICS_VERSION_NUM
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Mosics"
      VALUE "ProductName", "Mosics"
      VALUE "FileVersion", MOSICS_VERSION
      VALUE "ProductVersion", MOSICS_VERSION
      VALUE "OriginalFilename", "Mosics.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
